            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"InvoiceText":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
