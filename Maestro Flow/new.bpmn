          <uipath:input name="body" type="json" target="body"><![CDATA[{"entity":"=datafabric[bindings.bQBZpLFQA?folderPath=bindings.bap3JS209][\"qem:{\"selectedFields\":[\"CreateTime\",\"CreatedBy\",\"Id\",\"UpdateTime\",\"UpdatedBy\",\"freightAmount\",\"lineItems\",\"poDate\",\"poNumber\",\"subtotal\",\"taxAmount\",\"totalAmount\",\"vendorName\"],\"filterGroup\":{\"logicalOperator\":0,\"queryFilters\":[{\"fieldName\":\"poNumber\",\"operator\":\"=\",\"value\":\"=js:vars.script1.output.invoice.po_reference\"}]},\"limit\":100}\"]"}]]></uipath:input>
          <uipath:output name="queryEntityRecords1.output" type="object" source="=datafabric.__vdoself_queryEntityRecords1" var="queryEntityRecords1.output" />
        </uipath:mapping>
