    {
      "id": "dataextractionagent1",
      "type": "uipath.core.agent.690a4503-8b3d-4ea9-8283-57e1fc301f2a",
      "typeVersion": "1.0.0",
      "display": {
        "label": "DataExtractionAgent",
        "subLabel": "",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "InvoiceText": {
          "type": "jsExpression",
          "expression": "$vars.emailReceived2.output.Body",
          "fieldType": "string"
        }
      },
      "outputs": {
