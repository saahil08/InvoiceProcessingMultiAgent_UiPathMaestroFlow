      {
        "id": "discrepancyInvestigationAgent1.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "discrepancies": {
              "type": "array",
              "description": "Each discrepancy found between invoice and PO.",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "severity",
                  "explanation",
                  "evidence"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Name of the discrepant field, e.g. totalAmount, lineItems[2].unitPrice, vendorName."
                  },
                  "invoiceValue": {
                    "description": "Value of the field on the invoice. Use the natural JSON type (string, number, boolean)."
                  },
                  "poValue": {
                    "description": "Value of the field on the PO."
                  },
                  "deltaAmount": {
                    "type": "number",
                    "description": "Absolute USD difference where applicable. 0 for non-monetary fields."
                  },
                  "severity": {
                    "type": "string",
                    "description": "minor: note but does not change recommendation on its own. major: needs human review. critical: blocks payment.",
                    "enum": [
                      "minor",
                      "major",
                      "critical"
                    ]
                  },
                  "explanation": {
                    "type": "string",
                    "description": "Why this is a discrepancy and what the implication is."
                  },
                  "evidence": {
                    "type": "string",
                    "description": "Contract clause, catalog entry, step-by-step arithmetic, or 'direct field comparison'. Required for every item."
                  }
                }
              }
            },
            "totalAmountDelta": {
              "type": "number",
              "description": "Absolute USD difference between invoice totalAmount and PO totalAmount. 0 when totals match. Used to apply the USD 100 escalation threshold."
            },
            "recommendation": {
              "type": "string",
              "description": "Recommended downstream action.",
              "enum": [
                "approve",
                "escalate",
                "reject"
              ]
            },
            "escalated": {
              "type": "boolean",
              "description": "True if and only if the Human Review escalation was actually triggered during this run."
            }
          }
        },
        "binding": {
          "nodeId": "discrepancyInvestigationAgent1",
          "outputId": "output"
        }
      },
      {
        "id": "discrepancyInvestigationAgent1.error",
        "type": "object",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "code",
            "message",
            "detail",
            "category",
            "status"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "Error code as a string"
            },
            "message": {
              "type": "string",
              "description": "High-level error message"
            },
            "detail": {
              "type": "string",
              "description": "Detailed error description"
            },
            "category": {
              "type": "string",
              "description": "Error category"
            },
            "status": {
              "type": "integer",
              "description": "HTTP status code"
            }
          },
          "additionalProperties": false
        },
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "discrepancyInvestigationAgent1",
          "outputId": "error"
        }
      },
      {
        "id": "vendorResearchAgent1.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "relationship": {
              "type": "string",
              "description": "Relationship between the invoice vendor and the PO vendor. same_entity: different legal names, same company (DBA, abbreviation, translation, with/without suffix). parent_subsidiary: one is the legal parent of the other. affiliate: both share a common parent or are under common control. acquired_or_merged: one acquired or merged with the other. predecessor_successor: rebrand or legal name change. unrelated: no documented relationship. look_alike_or_typosquat: deliberate fraudulent look-alike. unknown: insufficient information.",
              "enum": [
                "same_entity",
                "parent_subsidiary",
                "affiliate",
                "acquired_or_merged",
                "predecessor_successor",
                "unrelated",
                "look_alike_or_typosquat",
                "unknown"
              ]
            },
            "flag": {
              "type": "string",
              "description": "Recommended downstream action. approve: legitimate relationship verified with high confidence. review: ambiguous, needs human review. reject: likely fraud or unrelated entity.",
              "enum": [
                "approve",
                "review",
                "reject"
              ]
            },
            "confidence": {
              "type": "string",
              "description": "Confidence in the relationship classification, based on quality and corroboration of sources.",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reasoning": {
              "type": "string",
              "description": "Concise explanation of how the relationship was determined. Reference specific corporate facts (acquisition year, parent/subsidiary structure, rebrand) discovered via web search."
            },
            "sources": {
              "type": "array",
              "description": "URLs of authoritative sources used to determine the relationship (SEC filings, official corporate pages, press releases, reputable news). At least 1 if relationship != unknown.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "binding": {
          "nodeId": "vendorResearchAgent1",
          "outputId": "output"
        }
      },
      {
