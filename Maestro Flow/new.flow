      "projectId": "c971b068-c36d-4189-a8fe-ea1e440556b5",
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "skipBindingsReference": true,
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "cfe8f0ab-fc5e-4cff-92d5-0b4aa3d4aa10",
          "orchestratorType": "agent",
          "values": [
            {
              "name": "name",
              "propertyAttribute": "name",
              "default": "Discrepancy Investigation agent"
            },
            {
              "name": "folderPath",
              "propertyAttribute": "folderPath",
              "default": ""
            }
          ]
        },
        "projectId": "c971b068-c36d-4189-a8fe-ea1e440556b5",
        "projectName": "Discrepancy Investigation agent",
        "isInSolution": true,
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "<bindings.name>"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "<bindings.folderPath>"
          },
          {
            "name": "_label",
            "type": "string",
            "value": "Discrepancy Investigation agent"
          }
        ]
      },
      "form": {
        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.invoiceData",
                "type": "text",
                "label": "invoiceData"
              },
              {
                "name": "inputs.poData",
                "type": "text",
                "label": "poData"
              }
            ]
          }
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "invoiceData": {
            "type": "string",
            "description": "Extracted invoice data as a structured JSON string. Expected fields include vendorName, invoiceNumber, invoiceDate, dueDate, poReference (the PO number this invoice claims to fulfill), currency, lineItems (array of {sku, description, quantity, unitPrice, lineTotal}), subtotal, taxAmount, freightAmount, totalAmount, remitTo. Field names may vary by extractor; reason over the structure you receive."
          },
          "poData": {
            "type": "string",
            "description": "Extracted purchase order data as a structured JSON string. Expected fields parallel invoiceData: vendorName, poNumber, poDate, currency, lineItems (array of {sku, description, quantity, unitPrice, lineTotal}), subtotal, taxAmount, freightAmount, totalAmount, paymentTerms. Field names may vary by extractor."
          }
        }
      },
      "inputDefaults": {
        "invoiceData": "",
        "poData": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "discrepancies": {
                "type": "array",
                "description": "Each discrepancy found between invoice and PO.",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "severity",
                    "explanation",
                    "evidence"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Name of the discrepant field, e.g. totalAmount, lineItems[2].unitPrice, vendorName."
                    },
                    "invoiceValue": {
                      "description": "Value of the field on the invoice. Use the natural JSON type (string, number, boolean)."
                    },
                    "poValue": {
                      "description": "Value of the field on the PO."
                    },
                    "deltaAmount": {
                      "type": "number",
                      "description": "Absolute USD difference where applicable. 0 for non-monetary fields."
                    },
                    "severity": {
                      "type": "string",
                      "description": "minor: note but does not change recommendation on its own. major: needs human review. critical: blocks payment.",
                      "enum": [
                        "minor",
                        "major",
                        "critical"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "description": "Why this is a discrepancy and what the implication is."
                    },
                    "evidence": {
                      "type": "string",
                      "description": "Contract clause, catalog entry, step-by-step arithmetic, or 'direct field comparison'. Required for every item."
                    }
                  }
                }
              },
              "totalAmountDelta": {
                "type": "number",
                "description": "Absolute USD difference between invoice totalAmount and PO totalAmount. 0 when totals match. Used to apply the USD 100 escalation threshold."
              },
              "recommendation": {
                "type": "string",
                "description": "Recommended downstream action.",
                "enum": [
                  "approve",
                  "escalate",
                  "reject"
                ]
              },
              "escalated": {
                "type": "boolean",
                "description": "True if and only if the Human Review escalation was actually triggered during this run."
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
