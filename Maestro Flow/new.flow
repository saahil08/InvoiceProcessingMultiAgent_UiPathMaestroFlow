            "type": "string",
            "minLength": 1,
            "errorMessage": "Add a condition"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
