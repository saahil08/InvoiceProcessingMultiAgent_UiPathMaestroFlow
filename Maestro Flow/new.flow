      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartAgentJob",
        "version": "v2",
        "skipBindingsReference": true,
        "bindings": {
          "resource": "process",
          "resourceSubType": "Agent",
          "resourceKey": "1a2f3417-1b20-4914-a886-9bad8cb3850b",
          "orchestratorType": "agent",
          "values": [
            {
              "name": "name",
              "propertyAttribute": "name",
              "default": "Vendor Research agent"
            },
            {
              "name": "folderPath",
              "propertyAttribute": "folderPath",
              "default": ""
            }
          ]
        },
        "projectId": "05a94fdd-ac3d-45cb-91bf-37d89f661525",
        "projectName": "Vendor Research agent",
        "isInSolution": true,
        "context": [
          {
            "name": "name",
            "type": "string",
            "value": "<bindings.name>"
          },
          {
            "name": "folderPath",
            "type": "string",
            "value": "<bindings.folderPath>"
          },
          {
            "name": "_label",
            "type": "string",
            "value": "Vendor Research agent"
          }
        ]
      },
      "form": {
        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.invoiceVendorName",
                "type": "text",
                "label": "invoiceVendorName"
              },
              {
                "name": "inputs.poVendorName",
                "type": "text",
                "label": "poVendorName"
              }
            ]
          }
        ]
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "invoiceVendorName": {
            "type": "string",
            "description": "Vendor name exactly as it appears on the invoice. Pass through verbatim. Preserve casing, punctuation, suffixes (Inc, LLC, GmbH, etc.)."
          },
          "poVendorName": {
            "type": "string",
            "description": "Vendor name exactly as it appears on the matching purchase order. Pass through verbatim. Preserve casing, punctuation, and corporate suffixes."
          }
        }
      },
      "inputDefaults": {
        "invoiceVendorName": "",
        "poVendorName": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "relationship": {
                "type": "string",
                "description": "Relationship between the invoice vendor and the PO vendor. same_entity: different legal names, same company (DBA, abbreviation, translation, with/without suffix). parent_subsidiary: one is the legal parent of the other. affiliate: both share a common parent or are under common control. acquired_or_merged: one acquired or merged with the other. predecessor_successor: rebrand or legal name change. unrelated: no documented relationship. look_alike_or_typosquat: deliberate fraudulent look-alike. unknown: insufficient information.",
                "enum": [
                  "same_entity",
                  "parent_subsidiary",
                  "affiliate",
                  "acquired_or_merged",
                  "predecessor_successor",
                  "unrelated",
                  "look_alike_or_typosquat",
                  "unknown"
                ]
              },
              "flag": {
                "type": "string",
                "description": "Recommended downstream action. approve: legitimate relationship verified with high confidence. review: ambiguous, needs human review. reject: likely fraud or unrelated entity.",
                "enum": [
                  "approve",
                  "review",
                  "reject"
                ]
              },
              "confidence": {
                "type": "string",
                "description": "Confidence in the relationship classification, based on quality and corroboration of sources.",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reasoning": {
                "type": "string",
                "description": "Concise explanation of how the relationship was determined. Reference specific corporate facts (acquisition year, parent/subsidiary structure, rebrand) discovered via web search."
              },
              "sources": {
                "type": "array",
                "description": "URLs of authoritative sources used to determine the relationship (SEC filings, official corporate pages, press releases, reputable news). At least 1 if relationship != unknown.",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
